[Unit]
Description=Fixed loopback relay to the trusted cluster image registry
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/coder-workspace/runtime.json

[Service]
ExecStart=/usr/local/lib/coder-vm/registry-relay.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077

[Install]
WantedBy=multi-user.target
