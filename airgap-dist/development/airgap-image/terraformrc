# Terraform CLI configuration for Coder's provisioner (TF_CLI_CONFIG_FILE). Providers are installed only from the
# mirror baked into the image; nothing is fetched from the internet. A template that asks for a provider or version
# that isn't in the mirror fails at `terraform init` with a clear message instead of hanging on the network.
provider_installation {
  filesystem_mirror {
    path    = "/opt/terraform/plugins"
    include = ["*/*"]
  }
  direct {
    exclude = ["*/*"]
  }
}
disable_checkpoint = true
