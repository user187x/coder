+package settings
+
+import (
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+func TestNormalizeSymlinkTargets(t *testing.T) {
+	existing := t.TempDir()
+	missing := filepath.Join(t.TempDir(), "not-mounted-yet")
+	source := &Source{
+		Name: "home",
+		Config: SourceConfig{SymlinkTargets: []string{
+			existing + "/",
+			"",
+			"  ",
+			"relative/drive",
+			missing,
+			existing,
+		}},
+	}
+	normalizeSymlinkTargets(source)
+	want := []string{existing, missing}
+	if !slices.Equal(source.Config.SymlinkTargets, want) {
+		t.Fatalf("got %v, want %v", source.Config.SymlinkTargets, want)
+	}
+
+	empty := &Source{}
+	normalizeSymlinkTargets(empty)
+	if empty.Config.SymlinkTargets != nil {
+		t.Fatalf("absent setting must stay nil, got %v", empty.Config.SymlinkTargets)
+	}
+}
