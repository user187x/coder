new file mode 100644
index 0000000000..cf1e051df6
--- /dev/null
+++ b/backend/pkg/indexing/symlink_targets.go
@@ -0,0 +1,126 @@
+package indexing
+
+import (
+	"os"
+	"path/filepath"
+	"sync"
+
+	"github.com/gtsteffaniak/filebrowser/backend/internal/utils"
+	"github.com/gtsteffaniak/filebrowser/backend/pkg/indexing/iteminfo"
+	"github.com/gtsteffaniak/go-logger/logger"
+)
+
+// symlinkTargetSet holds Config.SymlinkTargets resolved with filepath.EvalSymlinks.
+// An entry whose directory is missing (eg. a disconnected drive) stays pending and is
+// retried when a path fails to match the resolved entries.
+type symlinkTargetSet struct {
+	mu       sync.Mutex
+	loaded   bool
+	resolved []string
+	pending  []string
+}
+
+// HasSymlinkTargets reports whether the source allows symlinks to resolve outside it.
+func (idx *Index) HasSymlinkTargets() bool {
+	return len(idx.Config.SymlinkTargets) > 0
+}
+
+// underSymlinkTarget reports whether an already resolved path is one of the source's
+// symlinkTargets or below one.
+func (idx *Index) underSymlinkTarget(realPath string) bool {
+	if !idx.HasSymlinkTargets() {
+		return false
+	}
+	t := &idx.symlinkTargets
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if !t.loaded {
+		t.pending = append([]string(nil), idx.Config.SymlinkTargets...)
+		t.loaded = true
+		t.resolvePendingLocked()
+	}
+	if t.matchLocked(realPath) {
+		return true
+	}
+	if len(t.pending) == 0 {
+		return false
+	}
+	t.resolvePendingLocked()
+	return t.matchLocked(realPath)
+}
+
+func (t *symlinkTargetSet) matchLocked(realPath string) bool {
+	for _, root := range t.resolved {
+		if withinRoot(root, realPath) {
+			return true
+		}
+	}
+	return false
+}
+
+func (t *symlinkTargetSet) resolvePendingLocked() {
+	stillPending := t.pending[:0]
+	for _, target := range t.pending {
+		resolved, err := filepath.EvalSymlinks(target)
+		if err != nil {
+			logger.Debugf("symlink target %v is not available: %v", target, err)
+			stillPending = append(stillPending, target)
+			continue
+		}
+		if info, err := os.Stat(resolved); err != nil || !info.IsDir() {
+			logger.Warningf("ignoring symlink target %v: not a directory", target)
+			continue
+		}
+		t.resolved = append(t.resolved, resolved)
+	}
+	t.pending = stillPending
+}
+
+// GetRealPathFor resolves an index path like GetRealPathScoped. When allowTargets is set it also
+// accepts symlinks that resolve into the source's symlinkTargets. Callers serving a public share
+// must pass false.
+func (idx *Index) GetRealPathFor(boundIndexPath string, allowTargets bool, relativePath ...string) (string, bool, error) {
+	return idx.getRealPathInternal(boundIndexPath, true, allowTargets, relativePath...)
+}
+
+// GetEntryPath resolves an index path without following a symlink in its last component, so
+// renaming or moving a link acts on the link and not on what it points to. isDir is false for a
+// symlink.
+func (idx *Index) GetEntryPath(boundIndexPath string, allowTargets bool, indexPath string) (string, bool, error) {
+	entryPath, err := idx.resolveEntry(utils.JoinUnderSourceRoot(idx.Path, indexPath))
+	if err != nil {
+		return "", false, err
+	}
+	info, err := os.Lstat(entryPath)
+	if err != nil {
+		return "", false, err
+	}
+	if err := idx.ensureResolvedContained(entryPath, boundIndexPath, allowTargets); err != nil {
+		return "", false, err
+	}
+	return entryPath, iteminfo.IsDirectory(info), nil
+}
+
+// InSourceTree reports whether a resolved filesystem path lies in the source itself. Paths
+// reached through symlinkTargets do not, and are never indexed.
+func (idx *Index) InSourceTree(realPath string) bool {
+	if withinRoot(filepath.Clean(idx.Path), realPath) {
+		return true
+	}
+	root, err := idx.filesystemBound("/")
+	return err == nil && withinRoot(root, realPath)
+}
+
+// symlinkDirInfo returns the target's info when a symlink entry in a listing points to a
+// directory the caller may open, so it can be listed as a folder. Dangling links and links that
+// fail ensureResolvedContained return false and keep being listed as files.
+func (idx *Index) symlinkDirInfo(fsPath string, opts Options) (os.FileInfo, bool) {
+	target, err := os.Stat(fsPath)
+	if err != nil || !iteminfo.IsDirectory(target) {
+		return nil, false
+	}
+	if _, err := idx.resolveSymlinksContained(fsPath, opts.BoundIndexPath, opts.AllowSymlinkTargets); err != nil {
+		return nil, false
+	}
+	return target, true
+}
