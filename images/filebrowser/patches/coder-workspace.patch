+package indexing
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	liberrors "github.com/gtsteffaniak/filebrowser/backend/internal/errors"
+	"github.com/gtsteffaniak/filebrowser/backend/pkg/indexing/iteminfo"
+	"github.com/gtsteffaniak/filebrowser/backend/pkg/settings"
+)
+
+// symlinkTargetFixture is the layout from the symlinkTargets acceptance tests:
+//
+//	src/sub/inside.txt
+//	src/in   -> src/sub         (inside the source)
+//	src/out  -> T               (outside, the allowed target)
+//	src/gone -> nonexistent     (dangling)
+//	src/etc  -> etc             (outside, never allowed)
+//	src/a    -> T/b -> etc      (chain whose final target is not allowed)
+//	T/file.txt, T/sub/deep.txt
+type symlinkTargetFixture struct {
+	root, source, target, other string
+}
+
+func setupSymlinkTargetFixture(t *testing.T) symlinkTargetFixture {
+	t.Helper()
+	root := t.TempDir()
+	f := symlinkTargetFixture{
+		root:   root,
+		source: filepath.Join(root, "src"),
+		target: filepath.Join(root, "T"),
+		other:  filepath.Join(root, "etc"),
+	}
+	writeFixtureFile(t, filepath.Join(f.source, "sub", "inside.txt"), "inside")
+	writeFixtureFile(t, filepath.Join(f.target, "file.txt"), "in-target")
+	writeFixtureFile(t, filepath.Join(f.target, "sub", "deep.txt"), "deep")
+	writeFixtureFile(t, filepath.Join(f.other, "passwd"), "secret")
+	links := map[string]string{
+		filepath.Join(f.source, "in"):   filepath.Join(f.source, "sub"),
+		filepath.Join(f.source, "out"):  f.target,
+		filepath.Join(f.source, "gone"): filepath.Join(root, "nonexistent"),
+		filepath.Join(f.source, "etc"):  f.other,
+		filepath.Join(f.target, "b"):    f.other,
+		filepath.Join(f.source, "a"):    filepath.Join(f.target, "b"),
+	}
+	for link, target := range links {
+		if err := os.Symlink(target, link); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return f
+}
+
+func writeFixtureFile(t *testing.T, path, content string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (f symlinkTargetFixture) index(targets ...string) *Index {
+	return &Index{
+		Source: settings.Source{
+			Path:   f.source,
+			Config: settings.SourceConfig{SymlinkTargets: targets},
+		},
+		folderSizes:         make(map[string]uint64),
+		folderSizesUnsynced: make(map[string]struct{}),
+	}
+}
+
+func listingNames(info *iteminfo.FileInfo) (folders, files []string) {
+	for _, d := range info.Folders {
+		folders = append(folders, d.Name)
+	}
+	for _, f := range info.Files {
+		files = append(files, f.Name)
+	}
+	return folders, files
+}
+
+func requireEscape(t *testing.T, what string, err error) {
+	t.Helper()
+	if !errors.Is(err, liberrors.ErrPathEscapesScope) {
+		t.Fatalf("%s: expected ErrPathEscapesScope, got %v", what, err)
+	}
+}
+
+func TestSymlinkTargets_ListingShowsOpenableSymlinkedFolders(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	cases := []struct {
+		name         string
+		idx          *Index
+		allowTargets bool
+		wantFolders  []string
+		wantFiles    []string
+	}{
+		{"default", f.index(), false, []string{"in", "sub"}, []string{"a", "etc", "gone", "out"}},
+		{"allowlist", f.index(f.target), true, []string{"in", "out", "sub"}, []string{"a", "etc", "gone"}},
+		// a public share request never sets AllowSymlinkTargets
+		{"allowlist, share request", f.index(f.target), false, []string{"in", "sub"}, []string{"a", "etc", "gone", "out"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			info, err := tc.idx.GetFileInfo(FileInfoRequest{
+				IndexPath:           "/",
+				FollowSymlinks:      true,
+				AllowSymlinkTargets: tc.allowTargets,
+				Expand:              true,
+				SkipExtendedAttrs:   true,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			folders, files := listingNames(info)
+			slices.Sort(folders)
+			slices.Sort(files)
+			if !slices.Equal(folders, tc.wantFolders) || !slices.Equal(files, tc.wantFiles) {
+				t.Fatalf("folders=%v files=%v, want folders=%v files=%v", folders, files, tc.wantFolders, tc.wantFiles)
+			}
+			for _, d := range info.Folders {
+				if d.Type != "directory" {
+					t.Fatalf("folder %s has type %q", d.Name, d.Type)
+				}
+			}
+		})
+	}
+}
+
+func TestSymlinkTargets_OpenFolderThroughLink(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	for _, tc := range []struct {
+		path string
+		want string
+	}{
+		{"/out", "file.txt"},
+		{"/out/sub", "deep.txt"},
+	} {
+		req := FileInfoRequest{IndexPath: tc.path, FollowSymlinks: true, Expand: true, SkipExtendedAttrs: true}
+		_, err := f.index().GetFileInfo(req)
+		requireEscape(t, "default "+tc.path, err)
+
+		req.AllowSymlinkTargets = true
+		info, err := f.index(f.target).GetFileInfo(req)
+		if err != nil {
+			t.Fatalf("allowlist %s: %v", tc.path, err)
+		}
+		if info.Type != "directory" {
+			t.Fatalf("allowlist %s: type %q", tc.path, info.Type)
+		}
+		_, files := listingNames(info)
+		if !slices.Contains(files, tc.want) {
+			t.Fatalf("allowlist %s: files=%v, want %s", tc.path, files, tc.want)
+		}
+	}
+}
+
+func TestSymlinkTargets_ReadFileThroughLink(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+
+	_, _, err := f.index().GetRealPathFor("/", false, "/out/file.txt")
+	requireEscape(t, "default", err)
+
+	realPath, isDir, err := f.index(f.target).GetRealPathFor("/", true, "/out/file.txt")
+	if err != nil || isDir {
+		t.Fatalf("allowlist: real=%q isDir=%v err=%v", realPath, isDir, err)
+	}
+	data, err := os.ReadFile(realPath)
+	if err != nil || string(data) != "in-target" {
+		t.Fatalf("read %q: %q %v", realPath, data, err)
+	}
+
+	// The same index without the flag (a public share) stays strict.
+	_, _, err = f.index(f.target).GetRealPathFor("/", false, "/out/file.txt")
+	requireEscape(t, "allowlist, share request", err)
+}
+
+func TestSymlinkTargets_StrictLookupNotServedFromCache(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	idx := f.index(f.target)
+	if _, _, err := idx.GetRealPathFor("/", true, "/out/file.txt"); err != nil {
+		t.Fatal(err)
+	}
+	_, _, err := idx.GetRealPathScoped("/", "/out/file.txt")
+	requireEscape(t, "strict after allowed lookup", err)
+	_, _, err = idx.GetRealPath("/out/file.txt")
+	requireEscape(t, "unscoped after allowed lookup", err)
+}
+
+func TestSymlinkTargets_WritePath(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	for _, p := range []string{"/out/new.txt", "/out/newdir/new.txt", "/out/sub/new.txt"} {
+		_, err := f.index().GetWritePath("/", false, p)
+		requireEscape(t, "default "+p, err)
+
+		realPath, err := f.index(f.target).GetWritePath("/", true, p)
+		if err != nil {
+			t.Fatalf("allowlist %s: %v", p, err)
+		}
+		want := filepath.Join(f.target, filepath.FromSlash(p[len("/out/"):]))
+		if realPath != want {
+			t.Fatalf("allowlist %s: got %q want %q", p, realPath, want)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(f.target, "new.txt")); !os.IsNotExist(err) {
+		t.Fatalf("resolving a write path must not create anything: %v", err)
+	}
+
+	// Paths inside the source are unaffected.
+	realPath, err := f.index().GetWritePath("/", false, "/sub/new.txt")
+	if err != nil || realPath != filepath.Join(f.source, "sub", "new.txt") {
+		t.Fatalf("in-source write path: %q %v", realPath, err)
+	}
+	realPath, err = f.index().GetWritePath("/", false, "/in/new.txt")
+	if err != nil || realPath != filepath.Join(f.source, "sub", "new.txt") {
+		t.Fatalf("write path through inside link: %q %v", realPath, err)
+	}
+}
+
+func TestSymlinkTargets_WritePathThroughDanglingLink(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	for _, idx := range []*Index{f.index(), f.index(f.target)} {
+		for _, p := range []string{"/gone", "/gone/new.txt"} {
+			if _, err := idx.GetWritePath("/", true, p); err == nil {
+				t.Fatalf("%s: expected an error for a dangling link", p)
+			}
+		}
+	}
+	if _, err := os.Lstat(filepath.Join(f.root, "nonexistent")); !os.IsNotExist(err) {
+		t.Fatalf("dangling link target was created: %v", err)
+	}
+}
+
+func TestSymlinkTargets_EntryPathForMoveAndDelete(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+
+	_, _, err := f.index().GetEntryPath("/", false, "/out/file.txt")
+	requireEscape(t, "default entry inside link", err)
+	_, err = f.index().GetFileInfo(FileInfoRequest{IndexPath: "/out/file.txt"})
+	requireEscape(t, "default lstat inside link", err)
+
+	entry, isDir, err := f.index(f.target).GetEntryPath("/", true, "/out/sub")
+	if err != nil || !isDir || entry != filepath.Join(f.target, "sub") {
+		t.Fatalf("allowlist entry: %q isDir=%v err=%v", entry, isDir, err)
+	}
+	if _, err = f.index(f.target).GetFileInfo(FileInfoRequest{IndexPath: "/out/file.txt", AllowSymlinkTargets: true}); err != nil {
+		t.Fatalf("allowlist lstat inside link: %v", err)
+	}
+
+	// The link itself is an entry of the source: rename and delete act on it, not on T.
+	for _, idx := range []*Index{f.index(), f.index(f.target)} {
+		entry, isDir, err = idx.GetEntryPath("/", false, "/out")
+		if err != nil || isDir || entry != filepath.Join(f.source, "out") {
+			t.Fatalf("link entry: %q isDir=%v err=%v", entry, isDir, err)
+		}
+	}
+}
+
+func TestSymlinkTargets_OnlyListedTargetsAllowed(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	idx := f.index(f.target)
+	for _, p := range []string{"/etc", "/etc/passwd", "/a", "/out/b", "/out/b/passwd"} {
+		_, _, err := idx.GetRealPathFor("/", true, p)
+		requireEscape(t, "GetRealPathFor "+p, err)
+		_, err = idx.GetFileInfo(FileInfoRequest{IndexPath: p, FollowSymlinks: true, AllowSymlinkTargets: true, Expand: true})
+		requireEscape(t, "GetFileInfo "+p, err)
+		_, err = idx.GetWritePath("/", true, p)
+		requireEscape(t, "GetWritePath "+p, err)
+	}
+	for _, dir := range []string{"/etc", "/a", "/out/b"} {
+		_, err := idx.GetWritePath("/", true, dir+"/new.txt")
+		requireEscape(t, "GetWritePath "+dir+"/new.txt", err)
+	}
+}
+
+func TestSymlinkTargets_UserScope(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	writeFixtureFile(t, filepath.Join(f.source, "user2", "secret.txt"), "user2")
+	if err := os.MkdirAll(filepath.Join(f.source, "user1"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(f.target, filepath.Join(f.source, "user1", "drive")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(f.source, "user2"), filepath.Join(f.source, "user1", "peer")); err != nil {
+		t.Fatal(err)
+	}
+	idx := f.index(f.target)
+
+	if _, _, err := idx.GetRealPathFor("/user1", true, "/user1/drive/file.txt"); err != nil {
+		t.Fatalf("link into an allowed target from the user's scope: %v", err)
+	}
+	_, _, err := idx.GetRealPathFor("/user1", true, "/user1/peer/secret.txt")
+	requireEscape(t, "link to another scope in the source", err)
+
+	info, err := idx.GetFileInfo(FileInfoRequest{
+		IndexPath:           "/user1",
+		FollowSymlinks:      true,
+		BoundIndexPath:      "/user1",
+		AllowSymlinkTargets: true,
+		Expand:              true,
+		SkipExtendedAttrs:   true,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	folders, files := listingNames(info)
+	if !slices.Equal(folders, []string{"drive"}) || !slices.Equal(files, []string{"peer"}) {
+		t.Fatalf("folders=%v files=%v", folders, files)
+	}
+}
+
+func TestSymlinkTargets_MissingTargetResolvedWhenItAppears(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	late := filepath.Join(f.root, "late")
+	if err := os.Symlink(late, filepath.Join(f.source, "late")); err != nil {
+		t.Fatal(err)
+	}
+	idx := f.index(late)
+	if _, _, err := idx.GetRealPathFor("/", true, "/late"); err == nil {
+		t.Fatal("expected an error while the target is missing")
+	}
+	writeFixtureFile(t, filepath.Join(late, "x.txt"), "x")
+	if _, _, err := idx.GetRealPathFor("/", true, "/late/x.txt"); err != nil {
+		t.Fatalf("target that appeared after first use: %v", err)
+	}
+}
+
+func TestSymlinkTargets_IndexingDoesNotDescend(t *testing.T) {
+	f := setupSymlinkTargetFixture(t)
+	idx := f.index(f.target)
+
+	// Scans list entries without FollowSymlinks, so a symlinked folder stays a file entry and is
+	// never opened.
+	dir, err := os.Open(f.source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dir.Close()
+	stat, err := dir.Stat()
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, err := idx.GetDirInfoCore(dir, stat, "/", Options{CheckViewable: true, SkipExtendedAttrs: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	folders, _ := listingNames(info)
+	if slices.Contains(folders, "out") || slices.Contains(folders, "in") {
+		t.Fatalf("scan listing resolved symlinked folders: %v", folders)
+	}
+
+	// Refreshing a folder reached through the link (as a listing or a write does) must not
+	// index it.
+	if err := idx.RefreshDirectory("/out/", false); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := idx.folderSizes["/out/"]; ok {
+		t.Fatal("folder under a symlink target was indexed")
+	}
+	if idx.InSourceTree(filepath.Join(f.target, "file.txt")) {
+		t.Fatal("a symlink target is not part of the source tree")
+	}
+}
