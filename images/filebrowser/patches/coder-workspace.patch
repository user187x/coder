+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "local.txt"), []byte("local"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest(http.MethodGet, "/api/raw?algo=zip", nil)
+	rec := httptest.NewRecorder()
+	// Only the first path is checked before the archive is built.
+	if _, err := BuildAndStreamArchive(rec, req, &requestContext{User: user}, "uploads", []string{"/local.txt", "/out/docs"}); err != nil {
+		t.Fatal(err)
+	}
+	if names := readZipFileNames(rec.Body.Bytes()); !slices.Equal(names, []string{"local.txt"}) {
+		t.Fatalf("archive entries %v, want only local.txt", names)
+	}
+
+	rec = httptest.NewRecorder()
+	if _, err := BuildAndStreamArchive(rec, req, &requestContext{User: user}, "uploads", []string{"/"}); err != nil {
+		t.Fatal(err)
+	}
+	names := readZipFileNames(rec.Body.Bytes())
+	if slices.ContainsFunc(names, func(n string) bool { return strings.HasSuffix(n, "plan-link.md") }) {
+		t.Fatalf("archive followed a symlink out of the source: %v", names)
+	}
+	if !slices.ContainsFunc(names, func(n string) bool { return strings.HasSuffix(n, "local.txt") }) {
+		t.Fatalf("archive is missing local.txt: %v", names)
+	}
+}
