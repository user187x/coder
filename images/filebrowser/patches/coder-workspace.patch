+func TestErrToStatus_ReadOnlyFilesystem(t *testing.T) {
+	erofs := &os.PathError{Op: "open", Path: "/mnt/cloud-drive-peers/bob/x", Err: syscall.EROFS}
+	if got := ErrToStatus(erofs); got != http.StatusForbidden {
+		t.Fatalf("ErrToStatus(EROFS) = %d", got)
+	}
+	status, err := writeErrStatus(fmt.Errorf("could not open temp file: %w", erofs))
+	if status != http.StatusForbidden || !errors.Is(err, libErrors.ErrWriteNotPermitted) {
+		t.Fatalf("writeErrStatus(EROFS) = %d, %v", status, err)
+	}
+	status, err = writeErrStatus(fmt.Errorf("could not open temp file: %w", &os.PathError{Op: "open", Path: "/x", Err: syscall.EACCES}))
+	if status != http.StatusForbidden || !errors.Is(err, libErrors.ErrWriteNotPermitted) {
+		t.Fatalf("writeErrStatus(EACCES) = %d, %v", status, err)
+	}
+	status, _ = writeErrStatus(io.ErrUnexpectedEOF)
+	if status != http.StatusInternalServerError {
+		t.Fatalf("writeErrStatus(other) = %d", status)
+	}
+	if status, _ := sanitizePutWriteError(erofs); status != http.StatusForbidden {
+		t.Fatalf("sanitizePutWriteError(EROFS) = %d", status)
+	}
+}
