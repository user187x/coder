+// sizeOnDisk returns the total size of the regular files at or below realPath, without
+// following symlinks (an archive skips symlinked folders as well).
+func sizeOnDisk(realPath string) (int64, error) {
+	var total int64
+	err := filepath.WalkDir(realPath, func(_ string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !entry.Type().IsRegular() {
+			return nil
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		total += info.Size()
+		return nil
+	})
+	return total, err
+}
