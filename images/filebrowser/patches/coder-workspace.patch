+// normalizeSymlinkTargets cleans config.symlinkTargets. Relative entries are dropped; missing
+// directories only warn, because mounted drives may appear after startup.
+func normalizeSymlinkTargets(config *Source) {
+	var targets []string
+	for _, target := range config.Config.SymlinkTargets {
+		target = strings.TrimSpace(target)
+		if target == "" {
+			continue
+		}
+		if !filepath.IsAbs(target) {
+			logger.Warningf("source %v: ignoring symlinkTargets entry %q, it must be an absolute path", config.Name, target)
+			continue
+		}
+		target = filepath.Clean(target)
+		if slices.Contains(targets, target) {
+			continue
+		}
+		if _, err := os.Stat(target); err != nil {
+			logger.Warningf("source %v: symlinkTargets entry %v is not available yet, it will be resolved when first used: %v", config.Name, target, err)
+		}
+		targets = append(targets, target)
+	}
+	config.Config.SymlinkTargets = targets
+}
