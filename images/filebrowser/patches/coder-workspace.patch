@@ -0,0 +1,149 @@
+package web
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/gtsteffaniak/filebrowser/backend/internal/database/users"
+	"github.com/gtsteffaniak/filebrowser/backend/internal/preview"
+	"github.com/gtsteffaniak/filebrowser/backend/pkg/indexing/iteminfo"
+)
+
+// startPreviewOnce starts the preview service: delete, move and rename clear thumbnails.
+var startPreviewOnce sync.Once
+
+// setupOutsideLinkHTTPTest builds on the upload fixture: source "uploads" with a link
+// /out -> <outside>, a folder outside the source that holds docs/plan.md.
+func setupOutsideLinkHTTPTest(t *testing.T) (root, outside string, user *users.User) {
+	t.Helper()
+	startPreviewOnce.Do(func() {
+		cacheDir, err := os.MkdirTemp("", "fb-symlink-preview-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = preview.StartPreviewGenerator(1, cacheDir)
+	})
+	root, user = setupUploadHTTPTest(t)
+	outside = filepath.Join(t.TempDir(), "drive")
+	if err := os.MkdirAll(filepath.Join(outside, "docs"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(outside, "docs", "plan.md"), []byte("hello-outside"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "out")); err != nil {
+		t.Fatal(err)
+	}
+	return root, outside, user
+}
+
+func getResource(t *testing.T, user *users.User, path string) (int, *iteminfo.ExtendedFileInfo) {
+	t.Helper()
+	req := httptest.NewRequest(http.MethodGet, "/api/resources?source=uploads&path="+url.QueryEscape(path), nil)
+	rec := httptest.NewRecorder()
+	status, err := resourceGetHandler(rec, req, &requestContext{User: user})
+	if err != nil {
+		return status, nil
+	}
+	var info iteminfo.ExtendedFileInfo
+	if decodeErr := json.Unmarshal(rec.Body.Bytes(), &info); decodeErr != nil {
+		t.Fatalf("decode %s: %v", path, decodeErr)
+	}
+	return http.StatusOK, &info
+}
+
+func TestOutsideSymlink_GetBelowLinkIsForbidden(t *testing.T) {
+	_, _, user := setupOutsideLinkHTTPTest(t)
+	for _, p := range []string{"/out", "/out/docs", "/out/docs/plan.md"} {
+		if status, _ := getResource(t, user, p); status != http.StatusForbidden {
+			t.Fatalf("GET %s: status %d, want 403", p, status)
+		}
+	}
+}
+
+func TestOutsideSymlink_CreateBelowLinkIsForbidden(t *testing.T) {
+	for _, c := range []struct {
+		name    string
+		path    string
+		headers map[string]string
+		isDir   bool
+		created string // relative to the outside folder
+	}{
+		{"upload", "/out/docs/new.txt", map[string]string{"X-File-Upload-Session": "s1"}, false, "docs/new.txt"},
+		{"upload into missing folder", "/out/docs/sub/new.txt", map[string]string{"X-File-Upload-Session": "s2"}, false, "docs/sub"},
+		{"create file", "/out/docs/empty.txt", nil, false, "docs/empty.txt"},
+		{"create folder", "/out/docs/folder", nil, true, "docs/folder"},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			_, outside, user := setupOutsideLinkHTTPTest(t)
+			target := "/api/resources?source=uploads&path=" + url.QueryEscape(c.path)
+			if c.isDir {
+				target += "&isDir=true"
