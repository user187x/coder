+	settings.Config.Server.SourceMap = map[string]*settings.Source{root: {Path: root, Name: "srv"}}
+	settings.Config.Server.NameToSource = map[string]*settings.Source{"srv": settings.Config.Server.SourceMap[root]}
+	settings.InitializeUserResolvers()
+	indexing.SetTestIndex("srv", root)
+	// The allowlist is on, but shares must still refuse paths through the link.
+	indexing.GetIndex("srv").Config.SymlinkTargets = []string{drive}
+
+	perms := users.SourceFilePermissions{View: true, Download: true, Modify: true, Create: true, Delete: true}
+	owner := &users.User{
+		FrontendUser: users.FrontendUser{
+			Username:    "symlink_share_owner",
+			Permissions: users.Permissions{Share: true},
+		},
+		BackendScopes:            []users.BackendScope{{Path: root, Scope: "/", Permissions: perms}},
+		BackendSourcePermissions: map[string]users.SourceFilePermissions{root: perms},
+		Version:                  users.SourcePermissionsMigrationVersion,
+	}
+	if err := state.CreateUser(owner, ""); err != nil {
+		t.Fatal(err)
+	}
+	got, err := state.GetUserByUsername(owner.Username)
+	if err != nil {
+		t.Fatal(err)
