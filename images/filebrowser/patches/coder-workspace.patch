index 0000000000..d718b67014
--- /dev/null
+++ b/backend/pkg/indexing/symlink_paths.go
@@ -0,0 +1,91 @@
+package indexing
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/gtsteffaniak/filebrowser/backend/internal/utils"
+)
+
+// withinRoot reports whether path equals root or lies below it. Both must already be resolved.
+func withinRoot(root, path string) bool {
+	rel, err := filepath.Rel(root, path)
+	if err != nil {
+		return false
+	}
+	return rel != ".." && !strings.HasPrefix(rel, ".."+string(filepath.Separator))
+}
+
+// ensureEntryContained checks the symlinks above the last component of fsPath, for callers that
+// act on the entry itself (lstat, delete, rename) and so do not follow a symlink there.
+func (idx *Index) ensureEntryContained(fsPath, boundIndexPath string, allowTargets bool) error {
+	entryPath, err := idx.resolveEntry(fsPath)
+	if err != nil {
+		return err
+	}
+	return idx.ensureResolvedContained(entryPath, boundIndexPath, allowTargets)
+}
+
+// resolveEntry resolves every symlink in fsPath except the last component.
+func (idx *Index) resolveEntry(fsPath string) (string, error) {
+	abs, err := filepath.Abs(fsPath)
+	if err != nil {
+		return "", err
+	}
+	if abs == filepath.Clean(idx.Path) {
+		// The source root itself; a symlinked root is followed by filesystemBound.
+		return idx.filesystemBound("/")
+	}
+	parent, err := filepath.EvalSymlinks(filepath.Dir(abs))
+	if err != nil {
+		return "", err
+	}
+	return filepath.Join(parent, filepath.Base(abs)), nil
+}
+
+// GetWritePath resolves an index path that may not exist yet to the filesystem path a write
+// would land on. Symlinks are resolved in the deepest existing ancestor (and in the path itself
+// when it exists) and the result must pass ensureResolvedContained, so a write through a symlink
+// that leaves the source fails with ErrPathEscapesScope instead of following it.
+func (idx *Index) GetWritePath(boundIndexPath string, allowTargets bool, indexPath string) (string, error) {
+	abs, err := filepath.Abs(utils.JoinUnderSourceRoot(idx.Path, indexPath))
+	if err != nil {
+		return "", err
+	}
+	existing := abs
+	var missing []string
+	for {
+		_, statErr := os.Lstat(existing)
+		if statErr == nil {
+			break
+		}
+		if !os.IsNotExist(statErr) {
+			return "", statErr
+		}
+		parent := filepath.Dir(existing)
+		if parent == existing {
+			return "", statErr
+		}
+		missing = append(missing, filepath.Base(existing))
+		existing = parent
+	}
+	// A dangling symlink fails here, rather than letting MkdirAll or O_CREAT create its target.
+	resolved, err := filepath.EvalSymlinks(existing)
+	if err != nil {
+		return "", err
+	}
+	for i := len(missing) - 1; i >= 0; i-- {
+		resolved = filepath.Join(resolved, missing[i])
+	}
+	if err := idx.ensureResolvedContained(resolved, boundIndexPath, allowTargets); err != nil {
+		return "", err
+	}
+	return resolved, nil
+}
+
+// ResolveContained resolves fsPath, a filesystem path reached under this source (eg. while
+// walking a directory), and checks the result like GetRealPathFor.
+func (idx *Index) ResolveContained(fsPath, boundIndexPath string, allowTargets bool) (string, error) {
+	return idx.resolveSymlinksContained(fsPath, boundIndexPath, allowTargets)
+}
