+		t.Fatal(err)
+	}
+	app.MustWireServices(state.Default())
+	t.Cleanup(func() { state.Close() })
+
+	root := t.TempDir()
+	drive := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(root, "docs"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(drive, filepath.Join(root, "out")); err != nil {
+		t.Fatal(err)
