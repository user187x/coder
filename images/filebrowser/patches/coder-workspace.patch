+// isWriteNotPermitted reports whether err is a write refused by the filesystem, eg. a drive
+// mounted read-only (EROFS) or a folder the server may not write to (EACCES, EPERM).
+func isWriteNotPermitted(err error) bool {
+	return errors.Is(err, libErrors.ErrWriteNotPermitted) || errors.Is(err, syscall.EROFS) || errors.Is(err, fs.ErrPermission)
+}
+
+// writeErrStatus maps a failed filesystem write to a status code and a response error. A write the
+// filesystem refuses is a 403 with a plain message rather than a 500 naming the path.
+func writeErrStatus(err error) (int, error) {
+	if isWriteNotPermitted(err) {
+		return http.StatusForbidden, libErrors.ErrWriteNotPermitted
+	}
+	return http.StatusInternalServerError, err
+}
+
+// symlinkTargetsAllowed reports whether a request may follow symlinks into its source's
+// symlinkTargets. Requests made through a public share never do.
+func symlinkTargetsAllowed(d *Context) bool {
+	return d.Share.Hash == ""
+}
