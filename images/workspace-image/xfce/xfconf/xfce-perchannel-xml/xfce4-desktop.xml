<?xml version="1.0" encoding="UTF-8"?>
<!-- Default desktop background (workspace image): XFCE's dark "cp-dark" wallpaper, zoomed to fill the screen. Users
     who choose another one in Desktop settings override it in their own ~/.config/xfce4/xfconf. The VNC display's
     monitor is VNC-0 (TigerVNC); monitor0 covers other X servers. -->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorVNC-0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/xfce/xfce-cp-dark.svg"/>
        </property>
      </property>
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/xfce/xfce-cp-dark.svg"/>
        </property>
      </property>
    </property>
  </property>
</channel>
